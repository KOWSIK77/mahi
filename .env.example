# Copy to .env.local (local) or add in your host's environment settings (e.g. Vercel → Project → Settings → Environment Variables).
# Never commit real values.

# Resend API key (https://resend.com/api-keys). Server-side only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered. Controlled by the server, never by the form.
CONTACT_TO_EMAIL=mahi@novacovenanttrading.com

# Sender address on a domain verified in Resend, e.g. "Nova Covenant Website <enquiries@novacovenanttrading.com>"
CONTACT_FROM_EMAIL=Nova Covenant Website <enquiries@novacovenanttrading.com>
